<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Pedido" table="pedido">
    	<!-- ID -->
        <id name="idPedido" column="idPedido">
            <generator class="identity"/>
        </id>
		<!-- Atributos - Columnas -->
        <property name="fechaTransaccion" column="fechaTransaccion" type="java.time.LocalDateTime" not-null="true"/>
        <property name="cerrado" column="cerrado" type="boolean" not-null="true"/>
	    
	    <many-to-one name="unidad" class="datos.UnidadVenta" column="idUnidadVenta" not-null="true"/>
    	<set name="items" table="itempedido" order-by="idItemPedido asc" inverse="true" cascade="save-update" lazy="false" fetch="select">
	        <key column="idPedido" not-null="true"  />
	        <one-to-many class="datos.ItemPedido" />
	    </set>
</class>
</hibernate-mapping>