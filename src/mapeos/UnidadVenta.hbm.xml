<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
  	<class name="datos.UnidadVenta" table="unidadventa" abstract="true">
  		<!-- ID -->
	    <id name="idUnidadVenta" column="idUnidadVenta">
	    	<generator class="identity"/>
	    </id>
	    <!-- Atributos - Columnas -->
	    <property name="nombreComercial" column="nombreComercial" type="string" not-null="true"/>
	    <property name="codigo" column="codigo" type="string" not-null="true" unique="true"/>
	    <property name="superficie" column="superficie" type="double" not-null="true"/>
	    
	    <set name="staff" table="empleado" order-by="idEmpleado asc" inverse="true" lazy="true" fetch="select">
		    <key column="idUnidadVenta"/>
		    <one-to-many class="datos.Empleado"/>
		</set>
	    
	    <set name="platos" table="plato" order-by="idPlato asc" inverse="true" cascade="save-update" lazy="false" fetch="select">
		    <key column="idUnidadVenta"/>
		    <one-to-many class="datos.Plato"/>
		</set>
	    
	    <many-to-one name="festival" class="datos.Festival" column="idFestival" not-null="true"/>
	    
	    <many-to-one name="responsable" class="datos.Empleado" column="idResponsable" not-null="true"/>
	    
	    <!-- Herencia -->
		<joined-subclass name="datos.PuestoDesarmable" table="puestodesarmable">
			<key column="idPuestoDesarmable"/>
			<property column="cantidadDeCarpas" name="cantidadDeCarpas" type="long" not-null="true"/>
			<property column="tiempoMontaje" name="tiempoMontaje" type="long" not-null="true"/>
		</joined-subclass>
		
		<joined-subclass name="datos.FoodTruck" table="foodtruck">
			<key column="idFoodTruck" />
			<property column="patente" name="patente" type="string" not-null="true"/>
			<property column="conexionElectrica" name="conexionElectrica" type="boolean" not-null="true"/>
		</joined-subclass>
	    
	</class>
</hibernate-mapping>